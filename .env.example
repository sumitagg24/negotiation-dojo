# There is nothing to configure at the repository root.
#
# The two real env files are:
#
#   backend/.env    <- copy backend/.env.example   (needs ASSEMBLYAI_API_KEY)
#   frontend/.env   <- copy frontend/.env.example  (defaults work as-is)
#
# Quickstart:
#
#   cd backend  && npm install && cp .env.example .env && npm run dev
#   cd frontend && npm install && cp .env.example .env && npm run dev
#
# The frontend never holds an AssemblyAI key. Every AssemblyAI call is made
# server-side by the backend.
