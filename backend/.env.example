# Required: your AssemblyAI key. Used for the Voice Agent API, the word-level
# streaming STT leg, AND the LLM Gateway (scorecard narrative). One key, all three.
ASSEMBLYAI_API_KEY=your_key_here

PORT=8080
NODE_ENV=development

# Local JSON fallback persistence so a mid-demo crash doesn't lose a session.
SESSION_STORE_PATH=./data/sessions.json

CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# OPTIONAL: bypass AssemblyAI's LLM Gateway with your own OpenAI-compatible model.
# Leave LLM_API_KEY blank to use the LLM Gateway (recommended, no extra signup).
# If neither is configured, scoring still works: the deterministic sub-scores are
# rendered with a built-in narrative template instead of an LLM call.
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://llm-gateway.assemblyai.com/v1/chat/completions
LLM_MODEL=qwen3.5-4b-32k-fast
LLM_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Word-level tell detection.
# The Voice Agent API's transcript.user event carries only {text, item_id} --
# no word timestamps and no confidence -- so tell detection runs on a second,
# parallel AssemblyAI Streaming STT (v3) connection fed the same mic audio.
# Set to false to fall back to event-derived timing estimates (no confidence data).
# ---------------------------------------------------------------------------
ENABLE_TELL_STT_LEG=true
